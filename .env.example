# Self-Wiki — Composer-first (copy to .env)

# Default provider for sync / wiki-synthesize / query (when no role override)
LLM_PROVIDER=local-gateway
# Legacy alias: LLM_PROVIDER=mlx normalizes to local-gateway
# LLM gateway (dev.local-ai): model aliases mlx | ultra | gpt | cloud
# cloud → LLM_CLOUD_MODEL (ultra | gpt on the gateway)
# myblog/self-wiki default: gpt → mlx (no ultra)
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL=gpt
# LLM_CLOUD_MODEL=gpt
# LLM_MODEL_FALLBACK=mlx
# Opt into ultra: LLM_MODEL=ultra make query Q='...'
# Slightly longer than gateway OPENROUTER_TIMEOUT_SECONDS (default 420)
# LLM_TIMEOUT_SECONDS=600
# RESERVED_OUTPUT_TOKENS=8192

# Role-specific providers (optional; override LLM_PROVIDER per pipeline stage)
# AGENT_LLM_PROVIDER=local-gateway   # discover / gap / evolution (make reflect)
# QUERY_LLM_PROVIDER=local-gateway
# QUERY_LLM_MODEL=cloud          # gateway: expands to LLM_CLOUD_MODEL
# TRACE_LLM_MODEL=gpt            # make trace / trace-serve default (mlx for private)
# TRACE_SCOPE_TOP_K=16           # single-doc pack size (hits + ±2 neighbors)
# LINT_LLM_PROVIDER=local-gateway
# WIKI_LLM_PROVIDER=local-gateway

# Optional cloud API (openai / openrouter + API key; gemini not recommended in HK)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_PROVIDER=openrouter

# local-gateway is last-resort fallback when LLM_MLX_LAST_RESORT=1 (default on).

# Last-resort local-gateway when cloud fails or has no API key (default on):
# LLM_MLX_LAST_RESORT=1

# Python batch wiki-synthesize/discover (default: Composer writes files in Cursor)
# ALLOW_PYTHON_LLM=1
# MAX_INGEST_BATCH_TOKENS=150000
# MAX_INGEST_BATCH_FILES=8
# INGEST_OUTPUT_PER_FILE=2500

# OpenAI-compatible cloud (alternative to gemini)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# OpenRouter (OpenAI-compatible multi-model gateway)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo   # optional
# OPENROUTER_APP_TITLE=self-wiki                         # optional
# LLM_PROVIDER=openrouter

# Fallback (cloud first for agents/query; local-gateway appended last when LLM_MLX_LAST_RESORT=1)
# AGENT_FALLBACK_PROVIDERS=local-gateway
# QUERY_FALLBACK_PROVIDERS=local-gateway
# LLM_FALLBACK_PROVIDERS=gemini
# LLM_FALLBACK_ENABLED=1

# Rate limiting for batch LLM calls (avoid Gemini 429)
# GEMINI_RETRY_ATTEMPTS=4
# GEMINI_RETRY_BACKOFF_SECONDS=20
# INGEST_REQUEST_DELAY_SECONDS=2
# MAX_CONTEXT_TOKENS=1000000
# RESERVED_OUTPUT_TOKENS=8192
# LLM_TIMEOUT_SECONDS=600

# WORKSPACE_PATH=/path/to/dev.self-wiki

# Cloudflare Pages (make publish) — build dist/ then wrangler pages deploy
# PUBLISH_DIR=dist
# CLOUDFLARE_PAGES_PROJECT=self-mirror   # → https://self-mirror.pages.dev
# CLOUDFLARE_PAGES_BRANCH=main    # must match Production branch in Pages settings
# Non-interactive auth (required for launchd; skip wrangler login in cron):
# CLOUDFLARE_API_TOKEN=          # Dashboard → My Profile → API Tokens → Create → Edit Cloudflare Pages
# CLOUDFLARE_ACCOUNT_ID=         # Dashboard → any zone → Overview → Account ID (right column)
# PUBLISH=1                    # optional; run make publish manually after review
# BUILD_ONLY=1                 # make publish: build dist/ only, skip deploy

# Theme incubation (make incubate-themes) — cross-file new L1 thresholds
# INCUBATE_SUPPORT_COUNT=3
# INCUBATE_MEAN_CONF=0.78
# INCUBATE_MAX_CONF=0.82
# INCUBATE_MIN_FILE_CONF=0.75
